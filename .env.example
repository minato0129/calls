# cp .env.example .env して値を入れる(.env は git に入れない)

# 開発中は true にすると時間割に関係なく全ルームが「授業中」になる
FORCE_OPEN=true

# 公開 URL。トンネルを使うときは発行された https://xxxx.trycloudflare.com を入れる
BASE_URL=http://localhost:8080

# 本番では必ず長いランダム文字列に変える(openssl rand -hex 32 など)
SESSION_SECRET=dev-secret-change-me

# dev(開発用ログイン)または microsoft
AUTH_MODE=dev
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# 次のコマンドで生成して貼り付ける(README 参照)
#   docker compose run --rm --no-deps server sh -c "go mod tidy && go run . -genvapid"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# 先生への再通知間隔(秒)。動作確認では 10 などに縮めると便利
RENOTIFY_SECONDS=180

MYSQL_ROOT_PASSWORD=root
MYSQL_PASSWORD=callsys
