# cp .env.example .env して値を入れる(.env は git に入れない)

# 開発中は true にすると時間割に関係なく全ルームが「授業中」になる
FORCE_OPEN=true

# 公開 URL。名前付きトンネルなら https://(公開ホスト名)、Quick Tunnel なら発行された https://xxxx.trycloudflare.com
BASE_URL=http://localhost:8080

# 本番では必ず長いランダム文字列に変える(openssl rand -hex 32 など)
SESSION_SECRET=dev-secret-change-me

# ログイン方式。microsoft(学校の Microsoft アカウントのみ・既定)
# Azure の設定なしで手元だけで試すときに限り dev(開発用ログイン)にできる
AUTH_MODE=microsoft

# Entra ID(Azure ポータル)の「アプリの登録」で作ったアプリの値(README 参照)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ログインを許可するメールのドメイン(カンマ区切り)。例: school.ac.jp
# 空なら制限しない(テナントのアカウントならログインできる。ゲストは常に不可)
ALLOWED_EMAIL_DOMAINS=

# 次のコマンドで生成して貼り付ける(README 参照)
#   docker compose run --rm --no-deps server sh -c "go mod tidy && go run . -genvapid"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 通知サービス(Apple / Google)に伝える連絡先。自分か学校のメールアドレスにする(mailto: は付けても付けなくてもよい)
VAPID_SUBJECT=admin@example.com

# 先生への再通知間隔(秒)。動作確認では 10 などに縮めると便利
RENOTIFY_SECONDS=180

# 時限の時間割(JST)。空なら 1限 9:15-10:45 … 6限 18:45-20:15
# 例: PERIODS=1=09:15-10:45,2=11:00-12:30,3=13:30-15:00,4=15:15-16:45,5=17:00-18:30,6=18:45-20:15
PERIODS=

MYSQL_ROOT_PASSWORD=root
MYSQL_PASSWORD=callsys

# Cloudflare の名前付きトンネルのトークン(docker compose --profile tunnel で使う)
# ダッシュボードの「cloudflared.exe service install eyJ...」の eyJ... の部分。パスワードと同じなので Git に入れない
CLOUDFLARE_TUNNEL_TOKEN=
