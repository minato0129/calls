# 入口の nginx。起動時に ${WEB_UPSTREAM} と ${API_UPSTREAM} が環境変数で置き換わる
#   /api, /auth → Go(server)
#   それ以外    → React(web)。開発中は Vite 開発サーバー、本番はビルド済みの静的配信

# WebSocket(Vite の HMR)のときだけ Connection: upgrade にする
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
}

# トンネルなど前段の HTTPS 終端から来たときは、その情報を Go に引き継ぐ
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

upstream api {
    server ${API_UPSTREAM};
    keepalive 16;
}

upstream web {
    server ${WEB_UPSTREAM};
}

server {
    listen 80;
    server_name _;
    client_max_body_size 1m;

    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        $connection_upgrade;

    # SSE(リアルタイム更新)はバッファさせず、長時間つなぎっぱなしにする
    location ~ ^/api/rooms/[^/]+/events$ {
        proxy_pass http://api;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    location /api/  { proxy_pass http://api; }
    location /auth/ { proxy_pass http://api; }

    location / {
        proxy_pass http://web;
        proxy_read_timeout 1h; # HMR の WebSocket を切らないため
    }
}
